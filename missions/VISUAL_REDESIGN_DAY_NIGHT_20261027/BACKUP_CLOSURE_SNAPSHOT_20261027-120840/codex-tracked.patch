-.visual-sprint .knx-orbit-tool-icon > svg { filter:drop-shadow(0 0 3px #fff4); }.visual-sprint .knx-orbit-tool > span:last-child { font-size:11px; text-shadow:0 1px 3px #1f075b; }
-.visual-sprint .knx-orbit-tool.is-active { border:0; box-shadow:none; }.visual-sprint .knx-orbit-tool.is-active .knx-orbit-tool-icon { box-shadow:inset 0 2px 6px #fff7ff88,0 0 0 3px #ae7eff44,0 0 0 4px #fff,0 0 22px #ddafff; }
-.visual-sprint .knx-orbit-floor { position:absolute; left:0; right:0; bottom:8px; height:50px; border:2px solid #e8bfff; border-radius:50%; transform:rotate(-5deg); box-shadow:0 0 7px #fff,0 0 20px #b366f9,inset 0 0 14px #b779f8; background:radial-gradient(ellipse,#dca6ff44,transparent 65%); }
-.visual-sprint .knx-orbit-floor::before { content:''; position:absolute; inset:-8px 14px; border:1px solid #c393ff99; border-radius:50%; transform:rotate(13deg); }
