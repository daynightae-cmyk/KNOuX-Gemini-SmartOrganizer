+import { Play, type LucideIcon } from 'lucide-react';
 import { KnouxMark } from './ReferenceAtmosphere';
 
-export interface OrbitTool { id: string; label: string; icon: LucideIcon; onClick: () => void; active?: boolean; disabled?: boolean }
+export type OrbitTone = 'violet' | 'blue' | 'teal' | 'amber' | 'emerald' | 'rose' | 'indigo' | 'sky';
 
-/** Navigation and preview control only. Native consent remains in each tool. */
-export function OrbitalControl({ title, subtitle, tools, onActivate, disabled = false, running = false }: {
-  title: string; subtitle: string; tools: OrbitTool[]; onActivate: () => void; disabled?: boolean; running?: boolean;
+export type OrbitToolState = 'available' | 'active' | 'loading' | 'failed' | 'disabled' | 'unavailable';
+
+export interface OrbitTool {
+  id: string;
+  label: string;
+  icon: LucideIcon;
+  onClick: () => void;
+  /** Selected/current destination. Mirrors OrbitToolState 'active'. */
+  active?: boolean;
+  disabled?: boolean;
+  /** Explicit runtime state. Falls back to active/disabled when omitted. */
+  state?: OrbitToolState;
+  /** Short truthful qualifier rendered as a tooltip + screen-reader text. */
+  hint?: string;
+  tone?: OrbitTone;
+}
+
+const TONES: OrbitTone[] = ['violet', 'blue', 'teal', 'amber', 'emerald', 'rose', 'indigo', 'sky'];
+
+const STATE_LABEL: Record<OrbitToolState, string> = {
+  available: 'available',
+  active: 'current',
+  loading: 'loading',
+  failed: 'failed',
+  disabled: 'disabled',
+  unavailable: 'unavailable',
+};
+
+function resolveState(tool: OrbitTool): OrbitToolState {
+  if (tool.state) return tool.state;
+  if (tool.disabled) return 'disabled';
+  return tool.active ? 'active' : 'available';
+}
+
+/**
+ * KNOuX Orbital Service Engine.
+ *
+ * A navigation, scope and preview control shared by every workspace. It owns no
+ * service state: each satellite invokes an existing page handler and the centre
+ * action opens the workspace's genuine review/preview surface. Native consent,
+ * progress and measured results stay inside each service.
+ */
+export function OrbitalControl({
+  title,
+  subtitle,
+  tools,
+  onActivate,
+  disabled = false,
+  running = false,
+  state,
+  eyebrow,
+}: {
+  title: string;
+  subtitle: string;
+  tools: OrbitTool[];
+  onActivate: () => void;
+  disabled?: boolean;
+  running?: boolean;
+  state?: 'ready' | 'loading' | 'failed' | 'unavailable';
+  eyebrow?: string;
 }) {
-  return <div className={`knx-orbit ${running ? 'is-running' : ''}`}>
-    <div className="knx-orbit-track" aria-hidden="true" />
-    <div className="knx-orbit-track knx-orbit-track-inner" aria-hidden="true" />
-    <div className="knx-orbit-floor" aria-hidden="true" />
-    <button className="knx-orbit-core" onClick={onActivate} disabled={disabled}>
-      <KnouxMark /><strong>{title}</strong><span>{subtitle}</span>
-      <span className="knx-orbit-arrow"><ArrowUpRight size={21} /></span>
-    </button>
-    <nav className="knx-orbit-tools" aria-label={title}>
-      {tools.map((tool, index) => <button key={tool.id} type="button" className={`knx-orbit-tool ${tool.active ? 'is-active' : ''}`}
-        style={{ '--orbit-index': index, '--orbit-count': tools.length } as React.CSSProperties}
-        onClick={tool.onClick} disabled={tool.disabled} aria-current={tool.active ? 'step' : undefined}>
